{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ansgarharmeier.vercel.app" }],
      "destination": "https://www.ansgarharmeier.de/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ansgarharmeier.vercel.app" }],
      "destination": "https://www.ansgarharmeier.de/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ansgarharmeier-ansgarhs-projects.vercel.app" }],
      "destination": "https://www.ansgarharmeier.de/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ansgarharmeier-ansgarhs-projects.vercel.app" }],
      "destination": "https://www.ansgarharmeier.de/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ansgarharmeier-git-main-ansgarhs-projects.vercel.app" }],
      "destination": "https://www.ansgarharmeier.de/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ansgarharmeier-git-main-ansgarhs-projects.vercel.app" }],
      "destination": "https://www.ansgarharmeier.de/:path*",
      "permanent": true
    }
  ]
}
